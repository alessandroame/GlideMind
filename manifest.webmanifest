{
  "name": "GlideMind - Paragliding Intelligence & Telemetry",
  "short_name": "GlideMind",
  "description": "Piattaforma avanzata di intelligenza meteorologica e analisi telemetrica per il volo libero in parapendio e deltaplano.",
  "start_url": "./index.html",
